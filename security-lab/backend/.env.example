# ============================================================
# NOVA Security Lab Environment — COPY TO .env
# ============================================================

# REQUIRED: must be "true" to start the lab server
ENABLE_DEMO_LAB=true

# REQUIRED: must NOT be "production"
NODE_ENV=development

# Lab server port (default 5001 — do NOT change)
LAB_PORT=5001

# ---- Admin DB pool (for XSS demo review storage) ----
LAB_DB_HOST=127.0.0.1
LAB_DB_PORT=5432
LAB_DB_NAME=nova_lab
LAB_DB_ADMIN_USER=nova_lab_admin
LAB_DB_ADMIN_PASSWORD=changeme_admin

# ---- Read-only DB pool (for SQL Injection demo queries) ----
LAB_DB_READONLY_USER=demo_readonly
LAB_DB_READONLY_PASSWORD=changeme_readonly
