# Nova E-Commerce Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# === APPLICATION ===
NODE_ENV=development
PORT=5000
LAB_PORT=5001
FRONTEND_PORT=3000

# === DATABASE ===
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nova_db
DB_USER=nova_admin
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# Demo/Lab DB role (read-only)
DB_DEMO_USER=nova_demo_readonly
DB_DEMO_PASSWORD=CHANGE_ME_LOCAL_DEMO_PASSWORD

# === SECURITY ===
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_64_CHARS
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
BCRYPT_ROUNDS=12

# === LAB MODE ===
# Set to 'true' ONLY in local development for security demonstrations
ENABLE_DEMO_LAB=true
LAB_SECRET_KEY=REPLACE_WITH_RANDOM_LAB_SECRET

# === CORS ===
ALLOWED_ORIGIN=http://localhost:3000

# === LOGGING ===
LOG_FILE=./logs/app.log.jsonl
LOG_LEVEL=info

# Next.js API routes (app/api/**)
DATABASE_URL=postgresql://nova_user:REPLACE_ME@127.0.0.1:5432/nova_db
ALLOWED_ORIGIN=http://localhost:3000
